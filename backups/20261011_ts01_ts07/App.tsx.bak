import React, { useState, useEffect, useMemo } from 'react';
import { BoostPlan, Category, PaymentTransaction, ReportItem, ServiceListing, User } from './types';
import {
  getServices,
  saveServices,
  fetchServicesFromRemote,
  createServiceRemote,
  updateServiceRemote,
  deleteServiceRemote,
  adminUpdateServiceStatusRemote,
  adminDeleteServiceRemote,
  subscribeToServicesRealtime,
  getPublicVisibleServices,
  getOwnerServices,
  SERVICES_VISIBILITY_EVENT,
  getCategories,
  getBoostPlans,
  getUsers,
  getCurrentUser,
  setCurrentUser,
  getFavorites,
  toggleFavorite,
  getTransactions,
  recordTransaction,
  getReports,
  updateReportStatus
} from './services/storage';
import { isSupabaseConfigured } from './services/supabase';
import { Header } from './components/Header';
import { Hero } from './components/Hero';
import { CategoryFilter } from './components/CategoryFilter';
import { ServiceCard } from './components/ServiceCard';
import { ServiceDetailModal } from './components/ServiceDetailModal';
import { PublishServiceModal } from './components/PublishServiceModal';
import { PromoteServiceModal } from './components/PromoteServiceModal';
import { ContactModal } from './components/ContactModal';
import { ReportModal } from './components/ReportModal';
import { AdminModal } from './components/AdminModal';
import { UserProfileModal } from './components/UserProfileModal';
import { HowItWorks } from './components/HowItWorks';
import { Footer } from './components/Footer';
import { LegalModal } from './components/LegalModal';
import { MobileBottomNav } from './components/MobileBottomNav';
import { ToastProvider, useToast } from './components/Toast';
import { AuthProvider, useAuth } from './context/AuthContext';
import {
  ArrowUpDown,
  Filter,
  Sparkles,
  Heart,
  Search,
  AlertCircle,
  Plus,
  CheckCircle2,
  Zap,
  SlidersHorizontal
} from 'lucide-react';

function AppContent() {
  const { showToast } = useToast();
  const {
    activeUser,
    user: authUser,
    isAuthenticated,
    canPublish,
    canModerate,
    selectDemoUser
  } = useAuth();

  // Core Data State
  const [services, setServices] = useState<ServiceListing[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [boostPlans, setBoostPlans] = useState<BoostPlan[]>([]);
  const [allUsers, setAllUsers] = useState<User[]>([]);
  const [favorites, setFavorites] = useState<string[]>([]);
  const [transactions, setTransactions] = useState<PaymentTransaction[]>([]);
  const [reports, setReports] = useState<ReportItem[]>([]);

  // Search & Filter State
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategoryId, setSelectedCategoryId] = useState('');
  const [selectedNeighborhood, setSelectedNeighborhood] = useState('');
  const [sortBy, setSortBy] = useState<'featured_first' | 'price_asc' | 'price_desc' | 'rating_desc' | 'newest'>('featured_first');
  const [onlyFavorites, setOnlyFavorites] = useState(false);
  const [mobileTab, setMobileTab] = useState<'explore' | 'favorites' | 'plans' | 'profile'>('explore');

  // Modal State
  const [selectedServiceForDetail, setSelectedServiceForDetail] = useState<ServiceListing | null>(null);
  const [isPublishModalOpen, setIsPublishModalOpen] = useState(false);
  const [editingService, setEditingService] = useState<ServiceListing | null>(null);
  const [isPromoteModalOpen, setIsPromoteModalOpen] = useState(false);
  const [promotePreSelectedService, setPromotePreSelectedService] = useState<ServiceListing | null>(null);
  const [contactService, setContactService] = useState<ServiceListing | null>(null);
  const [reportService, setReportService] = useState<ServiceListing | null>(null);
  const [isAdminModalOpen, setIsAdminModalOpen] = useState(false);
  const [isProfileModalOpen, setIsProfileModalOpen] = useState(false);
  const [profileInitialTab, setProfileInitialTab] = useState<'profile' | 'login' | 'register'>('profile');
  const [isLegalModalOpen, setIsLegalModalOpen] = useState(false);
  const [legalTab, setLegalTab] = useState<'terms' | 'privacy' | 'boost_terms' | 'rules'>('terms');

  const currentAuthUserId = isAuthenticated && authUser && !authUser.isDemo ? authUser.id : null;

  // Load initial data on mount & subscribe to Supabase Realtime
  useEffect(() => {
    setCategories(getCategories());
    setBoostPlans(getBoostPlans());
    setAllUsers(getUsers());
    setFavorites(getFavorites());
    setTransactions(getTransactions());
    setReports(getReports());
  }, []);

  // Synchronize services whenever authentication state or session visibility changes
  useEffect(() => {
    let active = true;

    // 1. Instant filtered local cache read (never exposes disconnected users' ads)
    setServices(getServices(currentAuthUserId));

    // 2. Fetch shared active services from Supabase
    fetchServicesFromRemote(currentAuthUserId).then(remoteServices => {
      if (active) {
        setServices(remoteServices);
      }
    });

    // 3. Listen to local session visibility events (login / logout)
    const handleVisibilityChange = () => {
      if (!active) return;
      setServices(getServices(currentAuthUserId));
      fetchServicesFromRemote(currentAuthUserId).then(updated => {
        if (active) {
          setServices(updated);
        }
      });
    };

    window.addEventListener(SERVICES_VISIBILITY_EVENT, handleVisibilityChange);

    // 4. Subscribe to real-time events across devices
    const unsubscribe = subscribeToServicesRealtime(() => {
      fetchServicesFromRemote(currentAuthUserId).then(updated => {
        if (active) {
          setServices(updated);
        }
      });
    });

    return () => {
      active = false;
      window.removeEventListener(SERVICES_VISIBILITY_EVENT, handleVisibilityChange);
      unsubscribe();
    };
  }, [currentAuthUserId]);

  // Strict public visibility filter: only active services from connected owners
  const publicVisibleServices = useMemo(() => {
    return getPublicVisibleServices(services, currentAuthUserId);
  }, [services, currentAuthUserId]);

  // Close open service modals if the service's owner disconnects or is no longer visible
  useEffect(() => {
    const visibleIds = new Set(publicVisibleServices.map(s => s.id));
    if (
      selectedServiceForDetail &&
      !visibleIds.has(selectedServiceForDetail.id) &&
      (!currentAuthUserId || selectedServiceForDetail.authorId !== currentAuthUserId)
    ) {
      setSelectedServiceForDetail(null);
    }
    if (contactService && !visibleIds.has(contactService.id)) {
      setContactService(null);
    }
    if (reportService && !visibleIds.has(reportService.id)) {
      setReportService(null);
    }
    if (promotePreSelectedService && !visibleIds.has(promotePreSelectedService.id)) {
      setPromotePreSelectedService(null);
    }
    if (editingService && (!currentAuthUserId || editingService.authorId !== currentAuthUserId)) {
      setEditingService(null);
    }
  }, [publicVisibleServices, currentAuthUserId]);

  // Unique neighborhoods list (only from publicly visible services)
  const neighborhoodList = useMemo(() => {
    const set = new Set<string>();
    publicVisibleServices.forEach(s => {
      if (s.neighborhood) set.add(s.neighborhood);
    });
    return Array.from(set).sort();
  }, [publicVisibleServices]);

  // Category service counts (only from publicly visible services)
  const categoryCounts = useMemo(() => {
    const counts: Record<string, number> = {};
    publicVisibleServices.forEach(s => {
      counts[s.categoryId] = (counts[s.categoryId] || 0) + 1;
    });
    return counts;
  }, [publicVisibleServices]);

  // Current authenticated user's own services (both published 'active' and editorial 'draft' for private profile management)
  const userServices = useMemo(() => {
    return getOwnerServices(services, currentAuthUserId);
  }, [services, currentAuthUserId]);

  // Visible favorites count
  const visibleFavoritesCount = useMemo(() => {
    const visibleIds = new Set(publicVisibleServices.map(s => s.id));
    return favorites.filter(id => visibleIds.has(id)).length;
  }, [favorites, publicVisibleServices]);

  // Filtered and Sorted Services
  const filteredAndSortedServices = useMemo(() => {
    let result = [...publicVisibleServices];

    // Favorites tab filter
    if (onlyFavorites || mobileTab === 'favorites') {
      result = result.filter(s => favorites.includes(s.id));
    }

    // Category filter
    if (selectedCategoryId) {
      result = result.filter(s => s.categoryId === selectedCategoryId);
    }

    // Neighborhood filter
    if (selectedNeighborhood) {
      result = result.filter(s => s.neighborhood === selectedNeighborhood);
    }

    // Search query
    if (searchQuery.trim()) {
      const q = searchQuery.toLowerCase().trim();
      result = result.filter(s =>
        s.title.toLowerCase().includes(q) ||
        s.description.toLowerCase().includes(q) ||
        s.neighborhood.toLowerCase().includes(q) ||
        s.authorName.toLowerCase().includes(q)
      );
    }

    // Sorting logic (Featured priority always strictly respected when in 'featured_first' mode)
    return [...result].sort((a, b) => {
      if (sortBy === 'featured_first') {
        // First priority: isFeatured (and higher rank plan)
        if (a.isFeatured && !b.isFeatured) return -1;
        if (!a.isFeatured && b.isFeatured) return 1;
        if (a.isFeatured && b.isFeatured) {
          const planA = boostPlans.find(p => p.id === a.featuredPlanId)?.priorityRank || 0;
          const planB = boostPlans.find(p => p.id === b.featuredPlanId)?.priorityRank || 0;
          if (planA !== planB) return planB - planA;
        }
        // Then by rating or creation date
        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      }
      if (sortBy === 'price_asc') {
        const pA = a.priceType === 'a_convenir' ? 999999 : a.price;
        const pB = b.priceType === 'a_convenir' ? 999999 : b.price;
        return pA - pB;
      }
      if (sortBy === 'price_desc') {
        const pA = a.priceType === 'a_convenir' ? 0 : a.price;
        const pB = b.priceType === 'a_convenir' ? 0 : b.price;
        return pB - pA;
      }
      if (sortBy === 'rating_desc') {
        return b.authorRating - a.authorRating;
      }
      if (sortBy === 'newest') {
        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      }
      return 0;
    });
  }, [publicVisibleServices, favorites, onlyFavorites, mobileTab, selectedCategoryId, selectedNeighborhood, searchQuery, sortBy, boostPlans]);

  // Featured count in current filtered view
  const featuredInView = useMemo(() => {
    return filteredAndSortedServices.filter(s => s.isFeatured);
  }, [filteredAndSortedServices]);

  // Handlers
  const handleSelectUser = (user: User) => {
    selectDemoUser(user);
    showToast(
      'info',
      `Has cambiado a la vista demo de ${user.name}`,
      user.role === 'admin'
        ? 'Modo Demostración (Inspección de administración de solo lectura)'
        : `Vecino de ${user.neighborhood} (Modo demostración de solo lectura)`
    );
  };

  const handleToggleFavorite = (serviceId: string) => {
    const updated = toggleFavorite(serviceId);
    setFavorites(updated);
    const isNowFav = updated.includes(serviceId);
    showToast(
      'success',
      isNowFav ? 'Añadido a tus favoritos' : 'Eliminado de tus favoritos',
      'Puedes consultar todos tus anuncios guardados en cualquier momento.'
    );
  };

  const handlePublishSuccess = async (
    newService: ServiceListing
  ): Promise<{
    success: boolean;
    syncedWithSupabase?: boolean;
    error?: string;
    supabaseError?: {
      code: string;
      message: string;
      details: string | null;
      hint?: string | null;
    };
  }> => {
    if (!canPublish || !authUser || authUser.isDemo) {
      const msg = 'Debes iniciar sesión con Supabase Auth para publicar.';
      showToast('error', 'Autenticación requerida', msg);
      return {
        success: false,
        syncedWithSupabase: false,
        error: msg,
        supabaseError: {
          code: 'AUTH_REQUIRED',
          message: msg,
          details: 'Inicia sesión con una cuenta real de Supabase Auth.'
        }
      };
    }

    const editorialStatus: 'active' | 'draft' =
      newService.status === 'draft' ? 'draft' : 'active';

    const resolvedPriceType: ServiceListing['priceType'] =
      newService.priceType === 'hora' ||
      newService.priceType === 'trabajo' ||
      newService.priceType === 'a_convenir'
        ? newService.priceType
        : Number(newService.price) === 0
          ? 'a_convenir'
          : 'hora';

    const serviceWithVerifiedAuthor: ServiceListing = {
      ...newService,
      priceType: resolvedPriceType,
      price:
        resolvedPriceType === 'a_convenir'
          ? 0
          : Number.isFinite(Number(newService.price)) && Number(newService.price) >= 0
            ? Number(newService.price)
            : 0,
      authorId: authUser.id,
      authorName: (authUser.name || 'Vecino').trim() || 'Vecino',
      authorAvatar:
        authUser.avatar ||
        'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80',
      status: editorialStatus,
      ownerSessionActive: true
    };

    const result = await createServiceRemote(serviceWithVerifiedAuthor, authUser.id);

    if (!result.success || (isSupabaseConfigured && !result.syncedWithSupabase)) {
      const code = result.supabaseError?.code || 'SUPABASE_INSERT_ERROR';
      const message =
        result.supabaseError?.message ||
        result.error ||
        'Supabase rechazó la inserción del anuncio en public.services.';
      const details = result.supabaseError?.details
        ? ` — Detalles: ${result.supabaseError.details}`
        : '';

      showToast(
        'error',
        `No se pudo guardar en Supabase [${code}]`,
        `${message}${details}`
      );

      return {
        success: false,
        syncedWithSupabase: false,
        error: result.error || `[${code}] ${message}${details}`,
        supabaseError: result.supabaseError
      };
    }

    const confirmedService = result.service;
    setServices(prev => [
      confirmedService,
      ...prev.filter(s => s.id !== confirmedService.id)
    ]);

    showToast(
      'success',
      editorialStatus === 'draft'
        ? 'Borrador guardado en tu perfil'
        : '¡Servicio publicado con éxito!',
      editorialStatus === 'draft'
        ? 'Tu borrador está oculto al público y solo tú puedes verlo o publicarlo desde tu perfil.'
        : result.syncedWithSupabase
          ? 'Confirmado en Supabase (public.services): visible mientras tu sesión esté iniciada.'
          : 'Guardado localmente. Vincula Supabase para compartirlo entre móviles.'
    );

    return {
      success: true,
      syncedWithSupabase: result.syncedWithSupabase
    };
  };

  const handleOpenEditService = (service: ServiceListing) => {
    if (!isAuthenticated || !authUser || authUser.isDemo) {
      showToast(
        'error',
        'Autenticación requerida',
        'Debes iniciar sesión con tu cuenta de Supabase Auth para editar tus anuncios.'
      );
      return;
    }
    if (service.authorId !== authUser.id) {
      showToast(
        'error',
        'Acceso restringido',
        'Solo el propietario autenticado puede editar su propio anuncio.'
      );
      return;
    }
    setEditingService(service);
    setIsPublishModalOpen(true);
  };

  const handleUpdateService = async (
    updatedService: ServiceListing
  ): Promise<{ success: boolean; error?: string }> => {
    if (!isAuthenticated || !authUser || authUser.isDemo) {
      const msg = 'Debes iniciar sesión con tu cuenta real de Supabase Auth para editar tus anuncios.';
      showToast('error', 'Autenticación requerida', msg);
      return { success: false, error: msg };
    }

    const target = services.find(s => s.id === updatedService.id);
    if (!target || target.authorId !== authUser.id) {
      const msg = 'Solo el propietario autenticado puede editar su propio anuncio.';
      showToast('error', 'Acceso restringido', msg);
      return { success: false, error: msg };
    }

    const res = await updateServiceRemote(updatedService, authUser.id);
    if (!res.success) {
      const errMsg = res.error || 'No se pudo actualizar el anuncio en Supabase.';
      showToast('error', 'Error al guardar cambios', errMsg);
      return { success: false, error: errMsg };
    }

    setServices(prev => prev.map(s => (s.id === updatedService.id ? updatedService : s)));
    showToast('success', 'Anuncio actualizado', 'Los cambios de tu anuncio se han guardado correctamente.');
    return { success: true };
  };

  const handleConfirmPromotion = async (serviceId: string, plan: BoostPlan, transaction: PaymentTransaction) => {
    // Record payment locally
    recordTransaction(transaction);
    setTransactions(prev => [transaction, ...prev]);

    // Update service locally in state and cache
    // (The database update is handled exclusively on the backend during PayPal capture)
    const updated = services.map(s => {
      if (s.id === serviceId) {
        return {
          ...s,
          isFeatured: true,
          featuredPlanId: plan.id,
          featuredPlanName: plan.name,
          featuredUntil: transaction.expiresAt
        };
      }
      return s;
    });
    setServices(updated);
    saveServices(updated);

    showToast(
      'success',
      `¡${plan.name} activado con éxito!`,
      `Tu anuncio cuenta con visibilidad destacada durante ${plan.durationDays} días.`
    );
  };

  const handleDeleteService = async (serviceId: string): Promise<{ success: boolean; error?: string }> => {
    if (!isAuthenticated || !authUser || authUser.isDemo) {
      const msg = 'Debes iniciar sesión con tu cuenta real de Supabase Auth para eliminar anuncios.';
      showToast('error', 'Autenticación requerida', msg);
      return { success: false, error: msg };
    }

    const target = services.find(s => s.id === serviceId);
    if (!target) {
      const msg = 'No se encontró el anuncio que intentas eliminar.';
      showToast('error', 'Anuncio no encontrado', msg);
      return { success: false, error: msg };
    }

    const isOwner = target.authorId === authUser.id;

    if (!isOwner && !canModerate) {
      const msg = 'Solo el propietario autenticado o un administrador verificado puede eliminar este anuncio.';
      showToast('error', 'Acceso restringido', msg);
      return { success: false, error: msg };
    }

    // Owners continue using deleteServiceRemote (restricted to own ads);
    // verified admins use adminDeleteServiceRemote (server route DELETE /api/admin/services/:serviceId) for third-party ads.
    const result = isOwner
      ? await deleteServiceRemote(serviceId, target.authorId)
      : await adminDeleteServiceRemote(serviceId, target.authorId);

    if (!result.success) {
      const errorMsg = result.error || 'No se pudo completar la eliminación del anuncio en Supabase.';
      showToast('error', 'Error al eliminar el anuncio', errorMsg);
      return { success: false, error: errorMsg };
    }

    setServices(prev => prev.filter(s => s.id !== serviceId));
    showToast('success', 'Anuncio eliminado', 'El servicio ha sido retirado de la plataforma.');
    return { success: true };
  };

  const handleToggleSuspendService = async (serviceId: string) => {
    if (!isAuthenticated || !authUser || authUser.isDemo || !canModerate) {
      showToast(
        'error',
        'Acción denegada',
        'Esta acción de moderación requiere una cuenta con permisos de Administrador verificados en el servidor.'
      );
      return;
    }

    const target = services.find(s => s.id === serviceId);
    if (!target) {
      showToast('error', 'Anuncio no encontrado', 'No se encontró el anuncio que intentas moderar.');
      return;
    }

    const nextStatus: 'active' | 'suspended' =
      target.status === 'suspended' ? 'active' : 'suspended';

    const res = await adminUpdateServiceStatusRemote(serviceId, nextStatus);
    if (!res.success) {
      showToast(
        'error',
        'Moderación remota no completada',
        res.error || 'No se pudo actualizar el estado del anuncio en el servidor.'
      );
      return;
    }

    const confirmedStatus: 'active' | 'suspended' = res.status || nextStatus;
    const updatedService: ServiceListing = { ...target, status: confirmedStatus };
    setServices(prev => prev.map(s => (s.id === serviceId ? updatedService : s)));
    showToast(
      'warning',
      'Estado de moderación actualizado',
      confirmedStatus === 'suspended'
        ? 'El anuncio ha sido suspendido correctamente.'
        : 'El anuncio ha sido reactivado correctamente.'
    );
  };

  const handleResolveReport = (reportId: string, status: 'reviewed' | 'dismissed') => {
    updateReportStatus(reportId, status);
    setReports(getReports());
    showToast('success', 'Denuncia tramitada', `Marcada como ${status === 'reviewed' ? 'revisada' : 'desestimada'}.`);
  };

  const handleOpenLegalModal = (tab: 'terms' | 'privacy' | 'boost_terms' | 'rules') => {
    setLegalTab(tab);
    setIsLegalModalOpen(true);
  };

  return (
    <div className="min-h-screen flex flex-col bg-[#F7F9F8] text-[#1C2A26]">
      {/* Header */}
      <Header
        currentUser={activeUser}
        allUsers={allUsers}
        onSelectUser={handleSelectUser}
        favoritesCount={favorites.length}
        onOpenFavorites={() => {
          setOnlyFavorites(true);
          const el = document.getElementById('servicios');
          el?.scrollIntoView({ behavior: 'smooth' });
        }}
        onOpenPublish={() => {
          setEditingService(null);
          setIsPublishModalOpen(true);
        }}
        onOpenPlans={() => {
          setPromotePreSelectedService(null);
          setIsPromoteModalOpen(true);
        }}
        onOpenHowItWorks={() => {
          const el = document.getElementById('como-funciona');
          el?.scrollIntoView({ behavior: 'smooth' });
        }}
        onOpenRules={() => handleOpenLegalModal('rules')}
        onOpenAdmin={() => setIsAdminModalOpen(true)}
        onOpenProfile={() => {
          setProfileInitialTab('profile');
          setIsProfileModalOpen(true);
        }}
        onOpenAuth={(tab) => {
          setProfileInitialTab(tab || 'login');
          setIsProfileModalOpen(true);
        }}
        activeSection="home"
      />

      <main className="flex-1 pb-16 lg:pb-0">
        {/* Hero Section with Search and Neighborhood Filter */}
        <Hero
          searchQuery={searchQuery}
          onSearchChange={setSearchQuery}
          selectedNeighborhood={selectedNeighborhood}
          onNeighborhoodChange={setSelectedNeighborhood}
          neighborhoodList={neighborhoodList}
          categories={categories}
          selectedCategoryId={selectedCategoryId}
          onSelectCategory={setSelectedCategoryId}
          onOpenPublish={() => {
            setEditingService(null);
            setIsPublishModalOpen(true);
          }}
        />

        {/* Explore & Services Directory Section */}
        <section id="servicios" className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
          
          {/* Categories Navigation Component */}
          <CategoryFilter
            categories={categories}
            selectedCategoryId={selectedCategoryId}
            onSelectCategory={(id) => {
              setSelectedCategoryId(id);
              setOnlyFavorites(false);
            }}
            serviceCounts={categoryCounts}
          />

          {/* Controls Bar: Favorites Filter, Results Count & Sorting */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 border-t border-slate-200/80">
            <div className="flex items-center gap-2.5 flex-wrap">
              <span className="text-sm font-bold text-slate-800">
                {onlyFavorites ? 'Servicios guardados en favoritos' : 'Servicios disponibles en tu zona'}
              </span>
              <span className="text-xs text-slate-500 bg-white px-2.5 py-0.5 rounded-full border border-slate-200 font-semibold">
                {filteredAndSortedServices.length} {filteredAndSortedServices.length === 1 ? 'resultado' : 'resultados'}
              </span>
              {isSupabaseConfigured ? (
                <span className="text-[11px] text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200 font-medium hidden sm:inline-flex items-center gap-1">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                  Nube sincronizada (Tiempo real)
                </span>
              ) : (
                <span
                  className="text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200 font-medium hidden sm:inline-flex items-center gap-1"
                  title="Configura VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY para compartir entre múltiples dispositivos"
                >
                  Modo local (Supabase listo)
                </span>
              )}
              {onlyFavorites && (
                <button
                  onClick={() => setOnlyFavorites(false)}
                  className="text-xs text-[#146C5B] font-semibold hover:underline ml-1"
                >
                  Ver todos los anuncios
                </button>
              )}
            </div>

            {/* Sorting and Filter controls */}
            <div className="flex flex-wrap items-center gap-2 text-xs">
              {/* Favorites toggle button */}
              <button
                onClick={() => setOnlyFavorites(!onlyFavorites)}
                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl border transition-colors ${
                  onlyFavorites
                    ? 'bg-rose-50 border-rose-200 text-rose-700 font-semibold'
                    : 'bg-white border-slate-200 text-slate-700 hover:border-slate-300'
                }`}
              >
                <Heart className={`w-3.5 h-3.5 ${onlyFavorites ? 'fill-rose-600' : ''}`} />
                <span>Mis Favoritos ({favorites.length})</span>
              </button>

              {/* Sort selector */}
              <div className="flex items-center gap-1.5 bg-white border border-slate-200 rounded-xl px-2.5 py-1.5 text-slate-700">
                <ArrowUpDown className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                <span className="text-slate-400">Ordenar por:</span>
                <select
                  value={sortBy}
                  onChange={(e) => setSortBy(e.target.value as any)}
                  className="bg-transparent font-medium focus:outline-none cursor-pointer text-slate-900"
                >
                  <option value="featured_first">Destacados y recomendados primero</option>
                  <option value="rating_desc">Mejor valorados</option>
                  <option value="newest">Más recientes</option>
                  <option value="price_asc">Precio: menor a mayor</option>
                  <option value="price_desc">Precio: mayor a menor</option>
                </select>
              </div>
            </div>
          </div>

          {/* Active Filter Indicators */}
          {(selectedCategoryId || selectedNeighborhood || searchQuery || onlyFavorites) && (
            <div className="flex flex-wrap items-center gap-2 p-3 bg-white rounded-xl border border-slate-200 text-xs text-slate-600">
              <span className="font-semibold text-slate-800">Filtros aplicados:</span>
              {selectedCategoryId && (
                <span className="inline-flex items-center gap-1 bg-[#E5F3EF] text-[#0E5145] px-2.5 py-1 rounded-lg font-medium">
                  Categoría: {categories.find(c => c.id === selectedCategoryId)?.name}
                  <button onClick={() => setSelectedCategoryId('')} className="hover:text-black">×</button>
                </span>
              )}
              {selectedNeighborhood && (
                <span className="inline-flex items-center gap-1 bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-medium">
                  Barrio: {selectedNeighborhood}
                  <button onClick={() => setSelectedNeighborhood('')} className="hover:text-black">×</button>
                </span>
              )}
              {searchQuery && (
                <span className="inline-flex items-center gap-1 bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-medium">
                  Búsqueda: "{searchQuery}"
                  <button onClick={() => setSearchQuery('')} className="hover:text-black">×</button>
                </span>
              )}
              {onlyFavorites && (
                <span className="inline-flex items-center gap-1 bg-rose-50 text-rose-800 px-2.5 py-1 rounded-lg font-medium">
                  Solo favoritos
                  <button onClick={() => setOnlyFavorites(false)} className="hover:text-black">×</button>
                </span>
              )}
              <button
                onClick={() => {
                  setSelectedCategoryId('');
                  setSelectedNeighborhood('');
                  setSearchQuery('');
                  setOnlyFavorites(false);
                }}
                className="ml-auto text-xs text-slate-500 hover:text-red-600 font-semibold cursor-pointer"
              >
                Limpiar filtros
              </button>
            </div>
          )}

          {/* Featured Notice Banner if featured ads are visible */}
          {featuredInView.length > 0 && !searchQuery && !onlyFavorites && (
            <div className="flex items-center justify-between p-3.5 bg-gradient-to-r from-amber-50 to-[#E5F3EF]/40 border border-amber-200/80 rounded-xl text-xs text-amber-950">
              <div className="flex items-center gap-2">
                <Sparkles className="w-4 h-4 text-amber-600 shrink-0" />
                <span>
                  <strong>Anuncios destacados de vecinos:</strong> Mostrando en cabecera los servicios con promoción activa verificada.
                </span>
              </div>
              <button
                onClick={() => {
                  setPromotePreSelectedService(null);
                  setIsPromoteModalOpen(true);
                }}
                className="text-[#146C5B] font-bold hover:underline shrink-0 ml-2"
              >
                Destacar mi anuncio desde 1,50 €
              </button>
            </div>
          )}

          {/* Services Grid (Responsive: 1 col mobile, 2 col tablet, 3 col desktop) */}
          {filteredAndSortedServices.length === 0 ? (
            /* Friendly Empty State with useful guidance */
            <div className="py-16 px-4 bg-white rounded-2xl border border-slate-200 text-center max-w-lg mx-auto space-y-4">
              <div className="w-14 h-14 bg-[#E5F3EF] text-[#146C5B] rounded-full flex items-center justify-center mx-auto">
                <Search className="w-6 h-6" />
              </div>
              <div className="space-y-1">
                <h3 className="text-lg font-bold text-slate-900">
                  No se encontraron servicios con estos filtros
                </h3>
                <p className="text-xs text-slate-500 leading-relaxed">
                  Prueba a buscar con otras palabras clave, seleccionar otro barrio o limpiar los filtros para ver todos los anuncios vecinales.
                </p>
              </div>
              <div className="pt-2 flex flex-wrap items-center justify-center gap-3">
                <button
                  onClick={() => {
                    setSearchQuery('');
                    setSelectedCategoryId('');
                    setSelectedNeighborhood('');
                    setOnlyFavorites(false);
                  }}
                  className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold rounded-xl transition-colors"
                >
                  Restablecer filtros
                </button>
                <button
                  onClick={() => {
                    setEditingService(null);
                    setIsPublishModalOpen(true);
                  }}
                  className="px-4 py-2 bg-[#146C5B] hover:bg-[#0E5145] text-white text-xs font-bold rounded-xl transition-colors"
                >
                  ¿Ofreces este servicio? Publícalo aquí
                </button>
              </div>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {filteredAndSortedServices.map((service) => {
                const category = categories.find(c => c.id === service.categoryId);
                const isFavorite = favorites.includes(service.id);
                return (
                  <ServiceCard
                    key={service.id}
                    service={service}
                    category={category}
                    isFavorite={isFavorite}
                    onToggleFavorite={handleToggleFavorite}
                    onViewDetails={(s) => setSelectedServiceForDetail(s)}
                    onPromoteService={(s) => {
                      setPromotePreSelectedService(s);
                      setIsPromoteModalOpen(true);
                    }}
                    currentUser={activeUser}
                  />
                );
              })}
            </div>
          )}
        </section>

        {/* 4 Boost Plans Promotional Banner Section */}
        <section className="bg-gradient-to-b from-white to-[#F7F9F8] py-14 border-t border-slate-200">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="text-center max-w-2xl mx-auto mb-10 space-y-2">
              <span className="text-xs font-semibold uppercase tracking-wider text-[#146C5B]">
                Multiplica tus clientes locales
              </span>
              <h2 className="text-2xl sm:text-3xl font-extrabold text-[#0E5145] tracking-tight">
                Planes de Destacados VecinoYa
              </h2>
              <p className="text-sm text-slate-600 leading-relaxed">
                Elige la duración y la visibilidad que mejor se adapte a tus necesidades. Precios transparentes y sin renovaciones ocultas.
              </p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {boostPlans.map((plan) => (
                <div
                  key={plan.id}
                  className="bg-white rounded-2xl border border-slate-200/90 p-5 flex flex-col justify-between space-y-4 hover:shadow-md transition-shadow relative overflow-hidden"
                >
                  {plan.id === 'premium' && (
                    <div className="absolute top-0 right-0 bg-amber-500 text-white text-[10px] font-bold px-3 py-0.5 rounded-bl-lg">
                      MÁS POPULAR
                    </div>
                  )}
                  <div className="space-y-3">
                    <div>
                      <h3 className="text-base font-extrabold text-[#0E5145]">{plan.name}</h3>
                      <p className="text-xs text-slate-500 mt-0.5">{plan.tagline}</p>
                    </div>
                    <div className="flex items-baseline gap-1">
                      <span className="text-3xl font-black text-[#0E5145] tabular-nums">
                        {plan.price.toFixed(2).replace('.', ',')} €
                      </span>
                      <span className="text-xs text-slate-500 font-medium">/ {plan.durationDays} días</span>
                    </div>
                    <ul className="space-y-2 text-xs text-slate-600 pt-2 border-t border-slate-100">
                      {plan.benefits.map((b, i) => (
                        <li key={i} className="flex items-start gap-1.5">
                          <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <button
                    onClick={() => {
                      setPromotePreSelectedService(null);
                      setIsPromoteModalOpen(true);
                    }}
                    className={`w-full py-2.5 rounded-xl text-xs font-bold transition-all ${
                      plan.id === 'premium'
                        ? 'bg-[#146C5B] text-white hover:bg-[#0E5145] shadow-xs'
                        : 'bg-[#E5F3EF] text-[#0E5145] hover:bg-[#146C5B] hover:text-white'
                    }`}
                  >
                    Seleccionar este plan
                  </button>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* How it Works Section */}
        <div id="como-funciona">
          <HowItWorks
            onOpenPublish={() => {
              setEditingService(null);
              setIsPublishModalOpen(true);
            }}
          />
        </div>
      </main>

      {/* Footer */}
      <Footer
        onOpenHowItWorks={() => {
          const el = document.getElementById('como-funciona');
          el?.scrollIntoView({ behavior: 'smooth' });
        }}
        onOpenPlans={() => {
          setPromotePreSelectedService(null);
          setIsPromoteModalOpen(true);
        }}
        onOpenLegal={handleOpenLegalModal}
        onOpenPublish={() => {
          setEditingService(null);
          setIsPublishModalOpen(true);
        }}
      />

      {/* Mobile Sticky Bottom Navigation Bar */}
      <MobileBottomNav
        currentTab={mobileTab}
        onSelectTab={(tab) => {
          setMobileTab(tab);
          if (tab === 'explore') {
            setOnlyFavorites(false);
            const el = document.getElementById('servicios');
            el?.scrollIntoView({ behavior: 'smooth' });
          } else if (tab === 'favorites') {
            setOnlyFavorites(true);
            const el = document.getElementById('servicios');
            el?.scrollIntoView({ behavior: 'smooth' });
          } else if (tab === 'plans') {
            setPromotePreSelectedService(null);
            setIsPromoteModalOpen(true);
          } else if (tab === 'profile') {
            setIsProfileModalOpen(true);
          }
        }}
        onOpenPublish={() => {
          setEditingService(null);
          setIsPublishModalOpen(true);
        }}
        favoritesCount={favorites.length}
        currentUser={activeUser}
        onOpenAdmin={() => setIsAdminModalOpen(true)}
      />

      {/* Modal: Service Details */}
      <ServiceDetailModal
        service={selectedServiceForDetail}
        category={categories.find(c => c.id === selectedServiceForDetail?.categoryId)}
        isOpen={Boolean(selectedServiceForDetail)}
        onClose={() => setSelectedServiceForDetail(null)}
        isFavorite={Boolean(selectedServiceForDetail && favorites.includes(selectedServiceForDetail.id))}
        onToggleFavorite={handleToggleFavorite}
        currentUser={activeUser}
        onOpenContact={(s) => setContactService(s)}
        onOpenPromote={(s) => {
          setPromotePreSelectedService(s);
          setIsPromoteModalOpen(true);
        }}
        onEditService={handleOpenEditService}
        onOpenReport={(s) => setReportService(s)}
        onDeleteService={handleDeleteService}
      />

      {/* Modal: Publish / Edit Service */}
      <PublishServiceModal
        isOpen={isPublishModalOpen}
        onClose={() => {
          setIsPublishModalOpen(false);
          setEditingService(null);
        }}
        categories={categories}
        currentUser={activeUser}
        onPublishSuccess={handlePublishSuccess}
        editingService={editingService}
        onUpdateSuccess={handleUpdateService}
        onOpenAuth={(tab) => {
          setProfileInitialTab(tab || 'login');
          setIsProfileModalOpen(true);
        }}
      />

      {/* Modal: Promote Service (4 Plans with Payment Verification) */}
      <PromoteServiceModal
        isOpen={isPromoteModalOpen}
        onClose={() => setIsPromoteModalOpen(false)}
        plans={boostPlans}
        userServices={userServices}
        preSelectedService={promotePreSelectedService}
        currentUser={activeUser}
        onConfirmPromotion={handleConfirmPromotion}
        onOpenAuth={(tab) => {
          setProfileInitialTab(tab || 'login');
          setIsProfileModalOpen(true);
        }}
      />

      {/* Modal: Direct Contact & Chat */}
      <ContactModal
        isOpen={Boolean(contactService)}
        onClose={() => setContactService(null)}
        service={contactService}
        currentUser={activeUser}
      />

      {/* Modal: Report Listing */}
      <ReportModal
        isOpen={Boolean(reportService)}
        onClose={() => setReportService(null)}
        service={reportService}
        currentUser={activeUser}
        onReportSuccess={() => {
          showToast('success', 'Denuncia enviada', 'Gracias por ayudar a mantener seguro VecinoYa.');
        }}
      />

      {/* Modal: Admin & Moderation Panel */}
      <AdminModal
        isOpen={isAdminModalOpen}
        onClose={() => setIsAdminModalOpen(false)}
        currentUser={activeUser}
        services={services}
        categories={categories}
        reports={reports}
        transactions={transactions}
        onToggleSuspendService={handleToggleSuspendService}
        onDeleteService={handleDeleteService}
        onResolveReport={handleResolveReport}
        onOpenAuth={(tab) => {
          setProfileInitialTab(tab || 'login');
          setIsProfileModalOpen(true);
        }}
      />

      {/* Modal: User Profile & Manage Listings */}
      <UserProfileModal
        isOpen={isProfileModalOpen}
        onClose={() => setIsProfileModalOpen(false)}
        user={activeUser}
        userServices={userServices}
        onOpenPublish={() => {
          setEditingService(null);
          setIsPublishModalOpen(true);
        }}
        onOpenPromote={(s) => {
          setPromotePreSelectedService(s);
          setIsPromoteModalOpen(true);
        }}
        onEditService={handleOpenEditService}
        onViewService={(s) => setSelectedServiceForDetail(s)}
        onDeleteService={handleDeleteService}
        initialTab={profileInitialTab}
      />

      {/* Modal: Legal & Privacy */}
      <LegalModal
        isOpen={isLegalModalOpen}
        onClose={() => setIsLegalModalOpen(false)}
        initialTab={legalTab}
      />
    </div>
  );
}

export default function App() {
  return (
    <ToastProvider>
      <AuthProvider>
        <AppContent />
      </AuthProvider>
    </ToastProvider>
  );
}

