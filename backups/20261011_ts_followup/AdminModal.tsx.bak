import React, { useState } from 'react';
import { Category, PaymentTransaction, ReportItem, ServiceListing, User } from '../types';
import { useAuth } from '../context/AuthContext';
import {
  X,
  Shield,
  AlertTriangle,
  CheckCircle2,
  Trash2,
  Sparkles,
  Layers,
  CreditCard,
  Lock,
  Search,
  Eye,
  Check,
  PauseCircle,
  PlayCircle,
  Info,
  LogIn
} from 'lucide-react';
import { CategoryIcon } from './CategoryIcon';

interface AdminModalProps {
  isOpen: boolean;
  onClose: () => void;
  currentUser: User;
  services: ServiceListing[];
  categories: Category[];
  reports: ReportItem[];
  transactions: PaymentTransaction[];
  onToggleSuspendService: (serviceId: string) => void;
  onDeleteService: (serviceId: string) => void;
  onResolveReport: (reportId: string, status: 'reviewed' | 'dismissed') => void;
  onOpenAuth?: (tab?: 'login' | 'register') => void;
}

export const AdminModal: React.FC<AdminModalProps> = ({
  isOpen,
  onClose,
  currentUser,
  services,
  categories,
  reports,
  transactions,
  onToggleSuspendService,
  onDeleteService,
  onResolveReport,
  onOpenAuth
}) => {
  const { isAuthenticated, user: authUser, canModerate } = useAuth();
  const [activeTab, setActiveTab] = useState<'services' | 'reports' | 'transactions' | 'categories'>('services');
  const [searchFilter, setSearchFilter] = useState('');

  if (!isOpen) return null;

  // Strict role check:
  // Must either be authenticated admin OR viewing demo admin in read-only mode
  const isDemoAdmin = currentUser.role === 'admin' && currentUser.isDemo;
  const isRealAdmin = canModerate;

  if (!isRealAdmin && !isDemoAdmin) {
    return (
      <div className="fixed inset-0 z-50 bg-slate-900/60 flex items-center justify-center p-4">
        <div className="bg-white rounded-2xl p-6 max-w-sm w-full text-center space-y-3 shadow-xl">
          <div className="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto">
            <Lock className="w-6 h-6" />
          </div>
          <h3 className="text-base font-bold text-slate-900">Acceso no autorizado</h3>
          <p className="text-xs text-slate-600">
            Esta sección está reservada a administradores de la plataforma VecinoYa con rol verificado en Supabase Auth.
          </p>
          <div className="pt-2 flex gap-2">
            <button
              onClick={onClose}
              className="flex-1 py-2 bg-slate-100 text-slate-700 rounded-xl text-xs font-semibold hover:bg-slate-200"
            >
              Cerrar
            </button>
            {onOpenAuth && (
              <button
                onClick={() => {
                  onClose();
                  onOpenAuth('login');
                }}
                className="flex-1 py-2 bg-[#146C5B] text-white rounded-xl text-xs font-semibold hover:bg-[#0E5145]"
              >
                Iniciar sesión
              </button>
            )}
          </div>
        </div>
      </div>
    );
  }

  const filteredServices = services.filter(s =>
    s.title.toLowerCase().includes(searchFilter.toLowerCase()) ||
    s.authorName.toLowerCase().includes(searchFilter.toLowerCase()) ||
    s.neighborhood.toLowerCase().includes(searchFilter.toLowerCase())
  );

  const pendingReportsCount = reports.filter(r => r.status === 'pending').length;

  return (
    <div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5">
      <div
        className="relative bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh] animate-in fade-in zoom-in-95 duration-200"
        role="dialog"
        aria-modal="true"
      >
        {/* Header */}
        <div className="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-amber-50/50">
          <div className="flex items-center gap-2.5">
            <div className="p-2 bg-amber-700 text-white rounded-xl shadow-xs">
              <Shield className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-lg font-bold text-slate-900">
                Panel de Moderación y Administración
              </h3>
              <p className="text-xs text-slate-500">
                Sesión autorizada: <strong>{currentUser.name}</strong> ({currentUser.email})
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition-colors"
            aria-label="Cerrar panel de administración"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Tab Navigation */}
        <div className="px-6 border-b border-slate-200 bg-white flex items-center gap-2 overflow-x-auto text-xs font-semibold">
          <button
            onClick={() => setActiveTab('services')}
            className={`py-3 px-3.5 border-b-2 transition-colors whitespace-nowrap ${
              activeTab === 'services'
                ? 'border-[#146C5B] text-[#0E5145]'
                : 'border-transparent text-slate-500 hover:text-slate-900'
            }`}
          >
            Anuncios publicados ({services.length})
          </button>
          <button
            onClick={() => setActiveTab('reports')}
            className={`py-3 px-3.5 border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap ${
              activeTab === 'reports'
                ? 'border-[#146C5B] text-[#0E5145]'
                : 'border-transparent text-slate-500 hover:text-slate-900'
            }`}
          >
            <span>Denuncias de vecinos</span>
            {pendingReportsCount > 0 && (
              <span className="px-1.5 py-0.2 bg-red-100 text-red-700 text-[10px] font-bold rounded-full">
                {pendingReportsCount} pendientes
              </span>
            )}
          </button>
          <button
            onClick={() => setActiveTab('transactions')}
            className={`py-3 px-3.5 border-b-2 transition-colors whitespace-nowrap ${
              activeTab === 'transactions'
                ? 'border-[#146C5B] text-[#0E5145]'
                : 'border-transparent text-slate-500 hover:text-slate-900'
            }`}
          >
            Historial de Destacados ({transactions.length})
          </button>
          <button
            onClick={() => setActiveTab('categories')}
            className={`py-3 px-3.5 border-b-2 transition-colors whitespace-nowrap ${
              activeTab === 'categories'
                ? 'border-[#146C5B] text-[#0E5145]'
                : 'border-transparent text-slate-500 hover:text-slate-900'
            }`}
          >
            Categorías ({categories.length})
          </button>
        </div>

        {/* Tab Body */}
        <div className="overflow-y-auto p-6 space-y-4">
          {/* Demo Admin Warning Banner */}
          {isDemoAdmin && !isRealAdmin && (
            <div className="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-2.5">
              <Info className="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
              <div className="space-y-1">
                <p className="font-bold">Modo Demostración — Inspección de Solo Lectura</p>
                <p className="text-amber-800">
                  Estás explorando el panel con el perfil simulado de administrador. Para ejecutar suspensiones, eliminaciones o resoluciones en la base de datos de producción, debes iniciar sesión con una cuenta de administrador verificada en Supabase Auth.
                </p>
              </div>
            </div>
          )}

          {activeTab === 'services' && (
            <div className="space-y-3">
              {/* Filter bar */}
              <div className="flex items-center gap-2 px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 text-xs">
                <Search className="w-4 h-4 text-slate-400" />
                <input
                  type="text"
                  placeholder="Buscar por título, autor o barrio..."
                  value={searchFilter}
                  onChange={(e) => setSearchFilter(e.target.value)}
                  className="w-full bg-transparent focus:outline-none text-slate-800"
                />
              </div>

              {/* Table / List */}
              <div className="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100">
                {filteredServices.map(service => (
                  <div key={service.id} className="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/60 transition-colors text-xs">
                    <div className="min-w-0 space-y-1">
                      <div className="flex items-center gap-2">
                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                          service.status === 'suspended'
                            ? 'bg-red-100 text-red-800'
                            : 'bg-emerald-100 text-emerald-800'
                        }`}>
                          {service.status === 'suspended' ? 'SUSPENDIDO' : 'ACTIVO'}
                        </span>
                        {service.isFeatured && (
                          <span className="px-2 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-bold flex items-center gap-1">
                            <Sparkles className="w-3 h-3 text-amber-600" />
                            {service.featuredPlanName || 'Destacado'}
                          </span>
                        )}
                        <span className="text-slate-400 truncate">· {service.neighborhood}</span>
                      </div>
                      <p className="font-bold text-slate-900 truncate text-sm">{service.title}</p>
                      <p className="text-slate-500">Por {service.authorName} ({service.authorId})</p>
                    </div>

                    <div className="flex items-center gap-2 shrink-0">
                      <button
                        onClick={() => onToggleSuspendService(service.id)}
                        className={`px-2.5 py-1.5 rounded-lg font-medium flex items-center gap-1 transition-colors ${
                          service.status === 'suspended'
                            ? 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'
                            : 'bg-amber-50 text-amber-800 hover:bg-amber-100'
                        }`}
                        title={service.status === 'suspended' ? 'Reactivar anuncio' : 'Suspender por incumplimiento'}
                      >
                        {service.status === 'suspended' ? (
                          <>
                            <PlayCircle className="w-3.5 h-3.5" />
                            <span>Reactivar</span>
                          </>
                        ) : (
                          <>
                            <PauseCircle className="w-3.5 h-3.5" />
                            <span>Suspender</span>
                          </>
                        )}
                      </button>

                      <button
                        onClick={() => {
                          if (window.confirm(`¿Confirmas la eliminación permanente del anuncio "${service.title}"?`)) {
                            onDeleteService(service.id);
                          }
                        }}
                        className="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                        title="Eliminar anuncio definitivamente"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {activeTab === 'reports' && (
            <div className="space-y-3">
              <div className="p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-950 flex items-start gap-2">
                <AlertTriangle className="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
                <p>
                  <strong>Almacenamiento local (no sincronizado con el servidor):</strong> Las denuncias listadas en esta pestaña se leen únicamente del <code>localStorage</code> de este navegador. Para compartir denuncias entre usuarios y administradores se requiere crear la tabla <code>public.service_reports</code> en Supabase y su ruta protegida en el backend.
                </p>
              </div>
              {reports.length === 0 ? (
                <div className="p-8 text-center bg-slate-50 rounded-xl border border-slate-200 text-slate-500 text-xs">
                  <CheckCircle2 className="w-8 h-8 text-emerald-600 mx-auto mb-2" />
                  <p className="font-semibold text-slate-800">No hay denuncias registradas en este navegador.</p>
                  <p className="mt-0.5">Las denuncias locales guardadas en este dispositivo aparecerán aquí.</p>
                </div>
              ) : (
                reports.map(rep => (
                  <div key={rep.id} className="p-4 bg-white border border-slate-200 rounded-xl space-y-2.5 text-xs">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                          rep.status === 'pending'
                            ? 'bg-red-100 text-red-800'
                            : 'bg-slate-100 text-slate-600'
                        }`}>
                          {rep.status === 'pending' ? 'PENDIENTE' : 'REVISADA'}
                        </span>
                        <span className="font-bold text-slate-900">{rep.serviceTitle}</span>
                      </div>
                      <span className="text-slate-400">
                        {new Date(rep.createdAt).toLocaleDateString('es-ES')}
                      </span>
                    </div>
                    <p className="text-slate-700">
                      <strong>Motivo:</strong> {rep.reason}. {rep.details && `Detalles: "${rep.details}"`}
                    </p>
                    <p className="text-slate-500">
                      Denunciante: {rep.reporterName} ({rep.reporterId})
                    </p>
                    {rep.status === 'pending' && (
                      <div className="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                        <button
                          onClick={() => onResolveReport(rep.id, 'dismissed')}
                          className="px-2.5 py-1 text-slate-600 hover:bg-slate-100 rounded-lg font-medium"
                        >
                          Desestimar
                        </button>
                        <button
                          onClick={() => onResolveReport(rep.id, 'reviewed')}
                          className="px-3 py-1 bg-[#146C5B] text-white hover:bg-[#0E5145] rounded-lg font-bold"
                        >
                          Marcar como revisada
                        </button>
                      </div>
                    )}
                  </div>
                ))
              )}
            </div>
          )}

          {activeTab === 'transactions' && (
            <div className="space-y-3">
              <div className="p-3.5 bg-emerald-50/70 border border-emerald-200 rounded-xl text-xs text-emerald-950 flex items-start gap-2">
                <CreditCard className="w-4 h-4 text-[#146C5B] shrink-0 mt-0.5" />
                <p>
                  Registro inmutable de compras de visibilidad. Todos los cobros se asocian a un código de referencia y fecha de caducidad automática de la promoción.
                </p>
              </div>
              <div className="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 text-xs">
                {transactions.map(tx => (
                  <div key={tx.id} className="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50">
                    <div className="space-y-0.5">
                      <div className="flex items-center gap-2">
                        <span className="font-mono font-bold text-slate-800">{tx.referenceCode}</span>
                        <span className="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">
                          {tx.status.toUpperCase()}
                        </span>
                        <span className="font-semibold text-[#0E5145]">{tx.planName}</span>
                      </div>
                      <p className="text-slate-600 font-medium">{tx.serviceTitle}</p>
                      <p className="text-slate-400 text-[11px]">
                        Usuario: {tx.userName} · Caduca: {new Date(tx.expiresAt).toLocaleDateString('es-ES')}
                      </p>
                    </div>
                    <div className="sm:text-right shrink-0">
                      <span className="text-sm font-bold text-slate-900 tabular-nums">
                        {tx.amount.toFixed(2).replace('.', ',')} €
                      </span>
                      <p className="text-[10px] text-slate-400">
                        {new Date(tx.createdAt).toLocaleDateString('es-ES')}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {activeTab === 'categories' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              {categories.map(cat => {
                const count = services.filter(s => s.categoryId === cat.id).length;
                return (
                  <div key={cat.id} className="p-3.5 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div className="flex items-center gap-2.5">
                      <div className="p-2 bg-white rounded-lg shadow-2xs text-[#146C5B]">
                        <CategoryIcon name={cat.iconName} className="w-4 h-4" />
                      </div>
                      <div>
                        <p className="font-bold text-slate-800">{cat.name}</p>
                        <p className="text-slate-400 text-[11px]">{cat.description}</p>
                      </div>
                    </div>
                    <span className="font-bold text-slate-700 bg-white px-2 py-1 rounded-md border border-slate-200">
                      {count} servicios
                    </span>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  );
};
